<style>
:root{--green:#123c35;--green2:#286458;--cream:#f6f5ef;--white:#fffefa;--muted:#687771;--line:#dfe6de;--gold:#e5ac79}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;background:var(--cream);color:#19332e;font-family:"DM Sans",sans-serif}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer}
.wrap{width:min(1160px,calc(100% - 40px));margin:auto}
header{height:84px;display:flex;align-items:center;justify-content:space-between;gap:18px}
.brand{display:flex;align-items:center;gap:12px;font-weight:800;font-family:Manrope,sans-serif}
.logo{display:grid;place-items:center;background:var(--green);color:white;width:46px;height:46px;border-radius:15px}
.brand small{display:block;font-size:10px;letter-spacing:2px;color:var(--muted);margin-top:4px}
nav{display:flex;gap:24px;font-size:13px;color:#52655d}
nav a:hover{color:var(--green2)}
.navright{display:flex;align-items:center;gap:10px}
.lang,.cta,.btn{border-radius:100px;padding:12px 17px;font-weight:700;font-size:12px}
.lang{border:1px solid var(--line);background:transparent;color:var(--green)}
.cta,.btn{background:var(--green);color:white;border:1px solid var(--green);display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:.2s}
.cta:hover,.btn:hover{background:var(--green2);transform:translateY(-2px)}
.hero{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:55px;padding:76px 0 72px;min-height:600px}
.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:2px;color:var(--green2);font-weight:800}
.eyebrow:before{content:"✳";color:var(--gold);margin-right:9px}
h1,h2,h3{font-family:Manrope,sans-serif}
h1{font-size:clamp(43px,6vw,74px);line-height:1.03;letter-spacing:-4px;margin:23px 0}
h1 em{color:var(--green2);font-style:normal}
.lead{font-size:16px;line-height:1.9;color:var(--muted);max-width:530px}
.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.btn.light{background:transparent;color:var(--green);border-color:#cbd7ce}
.note{font-size:12px;color:var(--muted);margin-top:25px}
.art{position:relative;min-height:440px;border-radius:30px;padding:28px;background:linear-gradient(140deg,#e0e9dc,#b5d0c0);overflow:hidden}
.circle{position:absolute;width:290px;height:290px;border:1px solid #ffffffaa;border-radius:50%;right:-70px;top:-60px}
.circle:after{content:"";position:absolute;inset:35px;border:1px solid #ffffffaa;border-radius:50%}
.arttag{display:inline-block;position:relative;background:#ffffffbb;padding:11px 15px;border-radius:30px;font-size:11px;font-weight:700}
.poster{position:absolute;inset:95px 28px 28px;background:var(--green);color:white;border-radius:22px;padding:28px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}
.poster:after{content:"言";position:absolute;right:-12px;bottom:-75px;font-size:230px;color:#ffffff0b}
.poster small{letter-spacing:2px;color:#d3e2d7;font-size:10px}
.poster h2{font-size:clamp(29px,3.5vw,43px);line-height:1.15;letter-spacing:-2px;max-width:310px;z-index:1}
.poster p{font-size:12px;color:#d3e2d7;z-index:1}
.ticker{background:var(--green);color:white;overflow:hidden;padding:20px 0}
.track{display:flex;width:max-content;animation:scroll 32s linear infinite}
.ticker:hover .track{animation-play-state:paused}
.trackgroup{display:flex;align-items:center;gap:25px;padding-right:25px;white-space:nowrap}
.tag{border:1px solid #ffffff35;border-radius:100px;padding:11px 17px;font-size:12px;font-weight:700;color:#edf4ed}
.tag b{color:var(--gold);margin-right:8px}
@keyframes scroll{to{transform:translateX(-50%)}}
section{padding:90px 0}
.heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:35px}
.heading h2,.about h2{font-size:clamp(32px,4vw,48px);line-height:1.12;letter-spacing:-2px;margin:14px 0 0;max-width:600px}
.heading p{max-width:390px;color:var(--muted);font-size:14px;line-height:1.8}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}
.card{padding:28px;border:1px solid var(--line);background:var(--white);border-radius:22px;transition:.25s}
.card:hover{transform:translateY(-6px);box-shadow:0 20px 50px #153d3010}
