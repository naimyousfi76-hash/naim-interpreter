.aboutgrid{display:grid;grid-template-columns:.9fr 1.1fr;gap:65px;align-items:center}
.quote{background:var(--green);color:white;padding:35px;border-radius:26px;min-height:300px;display:flex;flex-direction:column;justify-content:space-between}
.quote strong{font:700 30px/1.3 Manrope,sans-serif;letter-spacing:-1px}
.quote small{color:#d5e3d8;letter-spacing:1px}
.pills{display:flex;flex-wrap:wrap;gap:9px;margin-top:22px}
.pill{padding:9px 13px;border:1px solid #cad8cc;border-radius:100px;font-size:11px;font-weight:700}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}
.step{border-top:1px solid var(--line);padding-top:22px}
.step strong{font-size:12px;color:#ae7952}
.step h3{font-size:18px}
.contactbox{display:grid;grid-template-columns:1fr .85fr;gap:40px;align-items:center;background:var(--green);color:white;border-radius:30px;padding:clamp(28px,6vw,65px)}
