.contactbox p{color:#d7e3da;line-height:1.8;font-size:14px}
.contactlinks{display:grid;gap:12px}
.contactlink{padding:18px;border:1px solid #ffffff38;background:#ffffff0b;border-radius:16px;display:flex;justify-content:space-between;align-items:center;gap:12px}
.contactlink small{display:block;color:#d7e3da;font-size:10px;letter-spacing:1px;margin-bottom:6px}
.contactlink strong{font-size:13px;overflow-wrap:anywhere}
.contactlink b{font-size:22px;color:var(--gold)}
footer{display:flex;justify-content:space-between;gap:20px;padding:32px 0 40px;color:var(--muted);font-size:11px}
.reveal{opacity:0;transform:translateY(20px);transition:opacity .7s,transform .7s}
.reveal.visible{opacity:1;transform:none}
@media(max-width:800px){
.wrap{width:calc(100% - 32px)}
